# Copy to .env before starting Docker Compose.
# This deployment profile is intentionally SQLite + one backend process for a family NAS.

ENVIRONMENT=production
DEBUG=false

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# The first administrator is created once when no administrator exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

DATABASE_TYPE=sqlite
SQLITE_DB_PATH=/app/data/dayforge-v2.db

# Host-side persistent directory. Create it before startup and restrict access.
DAYFORGE_DATA_DIR=./data
DAYFORGE_PORT=8000

# Set these to the owner of DAYFORGE_DATA_DIR (`id -u` and `id -g`).
PUID=1000
PGID=1000

# Native Android clients do not require CORS. This value must be a JSON array.
# Example for a future browser client: ["https://dayforge.example.com"]
CORS_ORIGINS=[]
