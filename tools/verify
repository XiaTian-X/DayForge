#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
scope="${1:-all}"

case "$scope" in
  all|root|android|backend) ;;
  *)
    echo "Usage: tools/verify [all|root|android|backend]" >&2
    exit 2
    ;;
esac

verify_root() {
  git -C "$repo_root" diff --check
  git -C "$repo_root" diff --cached --check

  local tracked_ignored
  tracked_ignored="$(git -C "$repo_root" ls-files -ci --exclude-standard)"
  if [[ -n "$tracked_ignored" ]]; then
    echo "Files covered by .gitignore must not remain tracked:" >&2
    printf '%s\n' "$tracked_ignored" >&2
    exit 1
  fi

  if git -C "$repo_root" ls-files \
    | grep -Ev '(^|/)\.env\.example$' \
    | grep -Eq '(^|/)(\.env($|\.)|\.envrc$|local\.properties$|(keystore|signing|secrets)\.properties$|google-services\.json$|(service-account[^/]*|credentials[^/]*|client_secret[^/]*)\.json$|.*\.(jks|keystore|p12|pfx|pkcs12|pem|key|ppk|mobileprovision)$|.*\.(db|sqlite|sqlite3)(-(journal|wal|shm))?$|\.forgejo($|/))'; then
    echo "Forbidden secret, runtime database, or legacy CI file is tracked." >&2
    exit 1
  fi

  local required_ignored_path
  local required_ignored_paths=(
    ".codex/settings.json"
    ".claude/settings.local.json"
    "android/local.properties"
    "android/keystore.properties"
    "android/release.jks"
    "android/release.p12"
    "android/private.pem"
    "android/app/build/outputs/apk/debug/app-debug.apk"
    "backend/.env"
    "backend/.env.production"
    "backend/.venv/bin/python"
    "backend/credentials.local.json"
    "backend/service-account.json"
    "backend/data/dayforge.sqlite-wal"
  )
  for required_ignored_path in "${required_ignored_paths[@]}"; do
    if ! git -C "$repo_root" check-ignore --quiet --no-index "$required_ignored_path"; then
      echo "Required .gitignore coverage is missing for: $required_ignored_path" >&2
      exit 1
    fi
  done
}

find_java_home() {
  if [[ -n "${JAVA_HOME:-}" && -x "$JAVA_HOME/bin/java" ]]; then
    printf '%s\n' "$JAVA_HOME"
    return
  fi

  if command -v brew >/dev/null 2>&1; then
    local brew_jdk
    brew_jdk="$(brew --prefix openjdk@17 2>/dev/null || true)"
    if [[ -x "$brew_jdk/libexec/openjdk.jdk/Contents/Home/bin/java" ]]; then
      printf '%s\n' "$brew_jdk/libexec/openjdk.jdk/Contents/Home"
      return
    fi
    if [[ -x "$brew_jdk/bin/java" ]]; then
      printf '%s\n' "$brew_jdk"
      return
    fi
  fi

  if java_home="$(/usr/libexec/java_home -v 17 2>/dev/null)" && [[ -x "$java_home/bin/java" ]]; then
    printf '%s\n' "$java_home"
    return
  fi

  echo "JDK 17 not found. Set JAVA_HOME or install openjdk@17." >&2
  exit 1
}

verify_android() {
  local java_home
  java_home="$(find_java_home)"
  (
    cd "$repo_root/android"
    JAVA_HOME="$java_home" ./gradlew testDebugUnitTest lintDebug assembleDebug createDebugUnitTestCoverageReport
  )
}

verify_backend() {
  if ! command -v uv >/dev/null 2>&1; then
    echo "uv is required. Install the version used by backend/Dockerfile." >&2
    exit 1
  fi
  (
    cd "$repo_root/backend"
    uv sync --frozen
    uv run pytest
    uv run python scripts/export_openapi.py --check
  )
}

verify_root
case "$scope" in
  all)
    verify_backend
    verify_android
    ;;
  backend) verify_backend ;;
  android) verify_android ;;
  root) ;;
esac
