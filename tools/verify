#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
scope="${1:-all}"

case "$scope" in
  all|root|android|android-build|backend) ;;
  *)
    echo "Usage: tools/verify [all|root|android|android-build|backend]" >&2
    exit 2
    ;;
esac

verify_root() {
  git -C "$repo_root" diff --check
  git -C "$repo_root" diff --cached --check
  PYTHONPATH="$repo_root" python3 -m unittest discover \
    -s "$repo_root/tools/tests" -p 'test_*.py'

  local tracked_ignored
  tracked_ignored="$(git -C "$repo_root" ls-files -ci --exclude-standard)"
  if [[ -n "$tracked_ignored" ]]; then
    echo "Files covered by .gitignore must not remain tracked:" >&2
    printf '%s\n' "$tracked_ignored" >&2
    exit 1
  fi

  if git -C "$repo_root" ls-files \
    | grep -Ev '(^|/)\.env\.example$' \
    | grep -Eq '(^|/)(\.env($|\.)|\.envrc$|local\.properties$|(keystore|signing|secrets)\.properties$|google-services\.json$|(service-account[^/]*|credentials[^/]*|client_secret[^/]*)\.json$|.*\.(jks|keystore|p12|pfx|pkcs12|pem|key|ppk|mobileprovision)$|.*\.(db|sqlite|sqlite3)(-(journal|wal|shm))?$|\.forgejo($|/))'; then
    echo "Forbidden secret, runtime database, or legacy CI file is tracked." >&2
    exit 1
  fi

  local required_ignored_path
  local required_ignored_paths=(
    ".codex/settings.json"
    ".claude/settings.local.json"
    "android/local.properties"
    "android/keystore.properties"
    "android/release.jks"
    "android/release.p12"
    "android/private.pem"
    "android/app/build/outputs/apk/debug/app-debug.apk"
    "backend/.env"
    "backend/.env.production"
    "backend/.venv/bin/python"
    "backend/credentials.local.json"
    "backend/service-account.json"
    "backend/data/dayforge.sqlite-wal"
  )
  for required_ignored_path in "${required_ignored_paths[@]}"; do
    if ! git -C "$repo_root" check-ignore --quiet --no-index "$required_ignored_path"; then
      echo "Required .gitignore coverage is missing for: $required_ignored_path" >&2
      exit 1
    fi
  done
}

find_java_home() {
  if [[ -n "${JAVA_HOME:-}" && -x "$JAVA_HOME/bin/java" ]]; then
    printf '%s\n' "$JAVA_HOME"
    return
  fi

  if command -v brew >/dev/null 2>&1; then
    local brew_jdk
    brew_jdk="$(brew --prefix openjdk@17 2>/dev/null || true)"
    if [[ -x "$brew_jdk/libexec/openjdk.jdk/Contents/Home/bin/java" ]]; then
      printf '%s\n' "$brew_jdk/libexec/openjdk.jdk/Contents/Home"
      return
    fi
    if [[ -x "$brew_jdk/bin/java" ]]; then
      printf '%s\n' "$brew_jdk"
      return
    fi
  fi

  if java_home="$(/usr/libexec/java_home -v 17 2>/dev/null)" && [[ -x "$java_home/bin/java" ]]; then
    printf '%s\n' "$java_home"
    return
  fi

  echo "JDK 17 not found. Set JAVA_HOME or install openjdk@17." >&2
  exit 1
}

verify_android() {
  local java_home
  local warning_log
  local android_tasks=(lintDebug assembleDebug assembleDeviceTest assembleDeviceTestAndroidTest)
  if [[ "$scope" != "android-build" ]]; then
    ANDROID_SERIAL="$(python3 "$repo_root/tools/check_android_device.py")" || return 1
    export ANDROID_SERIAL
    android_tasks+=(connectedDeviceTestAndroidTest createDeviceTestCoverageReport)
  fi
  java_home="$(find_java_home)"
  warning_log="$(mktemp "${TMPDIR:-/tmp}/dayforge-android-warnings.XXXXXX")"
  if ! (
      cd "$repo_root/android"
      JAVA_HOME="$java_home" ./gradlew "${android_tasks[@]}"
    ) 2>&1 | tee "$warning_log"; then
    rm -f "$warning_log"
    return 1
  fi
  if ! python3 "$repo_root/tools/check_android_warnings.py" "$warning_log"; then
    rm -f "$warning_log"
    return 1
  fi
  rm -f "$warning_log"
  if [[ "$scope" != "android-build" ]]; then
    python3 "$repo_root/tools/check_android_results.py"
    python3 "$repo_root/tools/check_android_coverage.py"
  else
    echo "Android build/static checks passed; physical-device tests NOT RUN."
  fi
}

verify_backend() {
  if ! command -v uv >/dev/null 2>&1; then
    echo "uv is required. Install the version used by backend/Dockerfile." >&2
    exit 1
  fi
  (
    cd "$repo_root/backend"
    uv sync --frozen
    uv run --frozen ruff check --config pyproject.toml .
    uv run --frozen ruff format --check --config pyproject.toml .
    uv run --frozen mypy --config-file pyproject.toml
    uv run --frozen python -m pytest -p tests.warning_budget
    uv run --frozen python scripts/export_openapi.py --check
  )
}

verify_root
case "$scope" in
  all)
    verify_backend
    verify_android
    ;;
  backend) verify_backend ;;
  android|android-build) verify_android ;;
  root) ;;
esac
